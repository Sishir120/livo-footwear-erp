# LIVO GROUP OF INDUSTRIES — Production Environment Configuration
# Copy this file to .env on the VPS: `cp .env.production.example .env`
# Do NOT commit the populated .env to git (RULES.md §4).

# 1. Domain Configuration (Automatic HTTPS via Caddy)
DOMAIN=erp.livogroup.com

# 2. Application Secrets
# Generate a secure 32-byte secret key with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_generated_64_char_hex_secret

# 3. Database Credentials
POSTGRES_USER=livo_admin
POSTGRES_PASSWORD=replace_with_strong_random_db_password
POSTGRES_DB=livo_erp

# 4. CORS Policy (RULES.md §4 / ARCHITECTURE.md §10)
# Comma-separated list of allowed origins. Must match the exact HTTPS domain.
BACKEND_CORS_ORIGINS=https://erp.livogroup.com

# 5. Cloud Object Storage (Backblaze B2 / Cloudflare R2 per ARCHITECTURE.md §9)
STORAGE_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=your_access_key_id
STORAGE_SECRET_KEY=your_secret_access_key
STORAGE_BUCKET_NAME=livo-erp-storage
