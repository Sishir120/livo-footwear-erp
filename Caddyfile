{$DOMAIN:localhost} {
    # Enforce request body size limit to protect backend against memory exhaustion (streaming defense-in-depth)
    request_body {
        max_size 10MB
    }

    # Reject known oversized requests before proxying upstream
    @oversized_cl expression `{http.request.header.Content-Length} != "" && int({http.request.header.Content-Length}) > 10485760`
    respond @oversized_cl 413

    # Reverse proxy API and Swagger/OpenAPI endpoints to FastAPI backend
    handle /api/* {
        reverse_proxy backend:8000
    }
    handle /health/* {
        reverse_proxy backend:8000
    }
    handle /docs* {
        reverse_proxy backend:8000
    }
    handle /openapi.json {
        reverse_proxy backend:8000
    }

    # Reverse proxy all other frontend requests to Next.js
    handle {
        reverse_proxy frontend:3000
    }

    # Security headers per ARCHITECTURE.md §10 / RULES.md §4
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Structured logging
    log {
        output stdout
        format json
    }
}
