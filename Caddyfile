{$DOMAIN:localhost} {
    # Reverse proxy API and Swagger/OpenAPI endpoints to FastAPI backend
    handle /api/* {
        reverse_proxy backend:8000
    }
    handle /docs* {
        reverse_proxy backend:8000
    }
    handle /openapi.json {
        reverse_proxy backend:8000
    }

    # Reverse proxy all other frontend requests to Next.js
    handle {
        reverse_proxy frontend:3000
    }

    # Security headers per ARCHITECTURE.md §10 / RULES.md §4
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Structured logging
    log {
        output stdout
        format json
    }
}
