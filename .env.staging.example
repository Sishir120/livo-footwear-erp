# ==============================================================================
# LIVO FOOTWEAR ERP — STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# File: .env.staging.example
# Purpose: Environment template for isolated Staging deployment (Cloud PaaS / Local Staging)
# Instructions:
#   1. Copy this file to `.env.staging` (or inject into your staging hosting dashboard):
#      `cp .env.staging.example .env.staging`
#   2. Replace all placeholder values marked `replace_with_*`.
#   3. NEVER commit the populated `.env.staging` or secrets to version control.
# ==============================================================================

# 1. Environment & Operational Mode
ENVIRONMENT=staging
LIVO_DEV_MODE=false
# Demo account seeding (strictly disabled by default, strictly forbidden in production)
ENABLE_DEMO_SEEDING=false
AUTO_MIGRATE=true
# Trusted reverse proxy IPs / CIDRs (e.g. Render edge / Cloudflare IP ranges)
TRUSTED_PROXIES=127.0.0.1,::1
PROJECT_NAME="LIVO FOOTWEAR ERP (STAGING)"
VERSION=1.0.0

# 2. Cryptographic Security Key
# Generate a secure 64-character hex secret (32 bytes) with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_generated_64_char_hex_secret_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 3. Isolated Staging Database Connection (PostgreSQL)
# For Neon Free Tier:
#   DATABASE_URL=postgresql://livo_staging_owner:replace_with_db_password@ep-livo-staging-123456.ap-southeast-1.aws.neon.tech/livo_staging?sslmode=require
# For Local Staging Runner:
#   DATABASE_URL=postgresql://livo_staging:replace_with_db_password@127.0.0.1:5433/livo_staging
DATABASE_URL=postgresql://replace_with_user:replace_with_password@replace_with_host:5432/livo_staging?sslmode=require

# 4. Database Connection Pool Controls
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=15
DB_POOL_RECYCLE=1800

# 5. CORS Origins Allowlist (Locked to Staging URLs)
# Comma-separated list of approved frontend origins. Do NOT use wildcard '*' in staging!
BACKEND_CORS_ORIGINS=https://livo-staging.vercel.app,https://livo-footwear-erp.vercel.app,http://localhost:3000

# 6. Cookie & Session Policy
# In staging (LIVO_DEV_MODE=false), cookies MUST be Secure (HTTPS only) and SameSite=Lax
COOKIE_SAMESITE=lax

# 7. Frontend API Routing (Injected into Frontend Build / Vercel Environment)
# Points Next.js frontend to the public staging backend API
NEXT_PUBLIC_API_URL=https://replace_with_staging_backend.onrender.com

# 8. Staging Object Storage (Synthetic Document Vault)
# If using Cloudflare R2 / AWS S3 free tier:
STORAGE_ENDPOINT_URL=https://replace_with_account_id.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=replace_with_r2_access_key
STORAGE_SECRET_KEY=replace_with_r2_secret_key
STORAGE_BUCKET_NAME=livo-staging-vault

# 9. Automated Backup Configuration
BACKUP_SCHEDULE_CRON="0 2 * * *"
BACKUP_RETENTION_DAYS=7
BACKUP_TARGET_DIR=/var/backups/livo_staging
