# LIVO GROUP OF INDUSTRIES — Development Environment Configuration
# Copy this file to .env: `cp .env.example .env`

# 1. Application Secrets
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_generated_64_char_hex_secret_min_32_chars

# 2. Database Connection (SQLite default for dev, PostgreSQL for staging/prod)
DATABASE_URL=sqlite:///./livo_dev.db
# DATABASE_URL=postgresql://livo_admin:password@localhost:5432/livo_erp

# 3. Environment & Security
ENVIRONMENT=development
LIVO_DEV_MODE=true
# Demo account seeding (strictly disabled by default, strictly forbidden in production)
ENABLE_DEMO_SEEDING=false
AUTO_MIGRATE=true
TRUSTED_PROXIES=127.0.0.1,::1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 4. Storage (optional cloud object storage)
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET_NAME=livo-erp-storage
